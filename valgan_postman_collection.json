{
  "info": {
    "_postman_id": "c1a2b3c4-d5e6-7f8g-9h0i-j1k2l3m4n5o6",
    "name": "Valgan Procurement API",
    "description": "API endpoints for the Valgan Procurement Crawler Assessment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Basic Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Checks if the server is running."
          }
        },
        {
          "name": "Readiness Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            },
            "description": "Checks if the database is connected."
          }
        }
      ]
    },
    {
      "name": "Tenders",
      "item": [
        {
          "name": "Get All Tenders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tenders?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tenders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search Tenders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tenders/search?q=services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tenders", "search"],
              "query": [
                { "key": "q", "value": "services" }
              ]
            }
          }
        },
        {
          "name": "Get Tender by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tenders/{{tenderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tenders", "{{tenderId}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "valgan-secret-key-2026",
      "type": "string"
    },
    {
      "key": "tenderId",
      "value": "replace-with-actual-uuid",
      "type": "string"
    }
  ]
}
